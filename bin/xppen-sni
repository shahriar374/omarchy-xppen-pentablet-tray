#!/usr/bin/env python3
"""XPPen PenTablet tray item.

Publishes a real StatusNotifierItem (like Free Download Manager does) so the
Omarchy bar's system tray picks it up.  Because the item is not pinned, the
tray automatically files it in the drawer behind the chevron, revealed on
hover/click.

Left click  -> show the PenTablet settings window (starts the driver if needed)
Right click -> dbusmenu with Show / Restart / Quit
"""
import os
import subprocess

from gi.repository import GLib, Gio

BUS_NAME = "org.kde.StatusNotifierItem-xppen"
SNI_PATH = "/StatusNotifierItem"
MENU_PATH = "/MenuBar"
SNI_IFACE = "org.kde.StatusNotifierItem"
MENU_IFACE = "com.canonical.dbusmenu"
WATCHER_BUS = "org.kde.StatusNotifierWatcher"
WATCHER_PATH = "/StatusNotifierWatcher"

CTL = os.path.expanduser("~/.local/bin/xppen-ctl")
STATUS = os.path.expanduser("~/.local/bin/xppen-status")

ICON_NAME = "xppentablet"
TITLE = "XP-Pen PenTablet"

SNI_XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <method name="Activate">
      <arg type="i" direction="in"/>
      <arg type="i" direction="in"/>
    </method>
    <method name="SecondaryActivate">
      <arg type="i" direction="in"/>
      <arg type="i" direction="in"/>
    </method>
    <method name="ContextMenu">
      <arg type="i" direction="in"/>
      <arg type="i" direction="in"/>
    </method>
    <method name="Scroll">
      <arg type="i" direction="in"/>
      <arg type="s" direction="in"/>
    </method>
    <method name="ProvideXdgActivationToken">
      <arg type="s" direction="in"/>
    </method>
    <signal name="NewTitle"/>
    <signal name="NewIcon"/>
    <signal name="NewAttentionIcon"/>
    <signal name="NewOverlayIcon"/>
    <signal name="NewMenu"/>
    <signal name="NewToolTip"/>
    <signal name="NewStatus">
      <arg type="s"/>
    </signal>
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="WindowId" type="i" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconPixmap" type="a(iiay)" access="read"/>
    <property name="OverlayIconName" type="s" access="read"/>
    <property name="OverlayIconPixmap" type="a(iiay)" access="read"/>
    <property name="AttentionIconName" type="s" access="read"/>
    <property name="AttentionIconPixmap" type="a(iiay)" access="read"/>
    <property name="AttentionMovieName" type="s" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
  </interface>
</node>
"""

MENU_XML = """
<node>
  <interface name="com.canonical.dbusmenu">
    <property name="Version" type="u" access="read"/>
    <property name="TextDirection" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconThemePath" type="as" access="read"/>
    <method name="GetLayout">
      <arg type="i" direction="in"/>
      <arg type="i" direction="in"/>
      <arg type="as" direction="in"/>
      <arg type="u" direction="out"/>
      <arg type="(ia{sv}av)" direction="out"/>
    </method>
    <method name="GetGroupProperties">
      <arg type="ai" direction="in"/>
      <arg type="as" direction="in"/>
      <arg type="a(ia{sv})" direction="out"/>
    </method>
    <method name="GetProperty">
      <arg type="i" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="v" direction="out"/>
    </method>
    <method name="Event">
      <arg type="i" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="v" direction="in"/>
      <arg type="u" direction="in"/>
    </method>
    <method name="EventGroup">
      <arg type="a(isvu)" direction="in"/>
      <arg type="ai" direction="out"/>
    </method>
    <method name="AboutToShow">
      <arg type="i" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <method name="AboutToShowGroup">
      <arg type="ai" direction="in"/>
      <arg type="ai" direction="out"/>
      <arg type="ai" direction="out"/>
    </method>
    <signal name="ItemsPropertiesUpdated">
      <arg type="a(ia{sv})"/>
      <arg type="a(ias)"/>
    </signal>
    <signal name="LayoutUpdated">
      <arg type="u"/>
      <arg type="i"/>
    </signal>
  </interface>
</node>
"""

MENU_ITEMS = [
    (1, {"label": "Show window"}),
    (2, {"type": "separator"}),
    (3, {"label": "Restart driver"}),
    (4, {"label": "Quit driver"}),
]
MENU_ACTIONS = {
    1: [CTL, "show"],
    2: None,
    3: [CTL, "restart"],
    4: [CTL, "quit"],
}


def variant(value):
    return GLib.Variant("s", value)


def launch(args):
    subprocess.Popen(
        args,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def menu_child(item_id, props):
    p = {k: (GLib.Variant("s", v) if k != "enabled" else GLib.Variant("b", True))
         for k, v in props.items()}
    p.setdefault("enabled", GLib.Variant("b", True))
    return GLib.Variant("(ia{sv}av)", (item_id, p, []))


def build_layout():
    full = []
    for (i, p) in MENU_ITEMS:
        if p.get("type") == "separator":
            full.append(GLib.Variant("(ia{sv}av)",
                                     (i, {"type": GLib.Variant("s", "separator")}, [])))
        else:
            full.append(menu_child(i, p))
    return GLib.Variant("(u(ia{sv}av))",
                        (1, (0, {"children-display": GLib.Variant("s", "submenu")}, full)))


class TrayItem:
    def __init__(self):
        self.registered = False
        self.driver_running = False
        self.connection = None

    # ---- org.kde.StatusNotifierItem -------------------------------------
    def on_sni_method(self, conn, sender, path, iface, method, params, inv, user_data=None):
        if method == "Activate":
            launch([CTL, "show"])
        elif method == "SecondaryActivate":
            launch([CTL, "restart"])
        # ContextMenu/Scroll/ProvideXdgActivationToken: nothing to do; the
        # tray renders the dbusmenu at MENU_PATH itself.
        inv.return_value(None)

    def on_sni_property(self, conn, sender, path, iface, prop, user_data=None):
        values = {
            "Category": variant("ApplicationStatus"),
            "Id": variant("xppentablet"),
            "Title": variant(TITLE),
            "Status": variant("Active"),
            "WindowId": GLib.Variant("i", 0),
            "IconThemePath": variant(""),
            "Menu": GLib.Variant("o", MENU_PATH),
            "ItemIsMenu": GLib.Variant("b", False),
            "IconName": variant(ICON_NAME),
            "IconPixmap": GLib.Variant("a(iiay)", []),
            "OverlayIconName": variant(""),
            "OverlayIconPixmap": GLib.Variant("a(iiay)", []),
            "AttentionIconName": variant(""),
            "AttentionIconPixmap": GLib.Variant("a(iiay)", []),
            "AttentionMovieName": variant(""),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (ICON_NAME, [], TITLE, "")),
        }
        return values.get(prop, GLib.Variant("s", ""))

    # ---- com.canonical.dbusmenu -----------------------------------------
    def on_menu_method(self, conn, sender, path, iface, method, params, inv, user_data=None):
        if method == "GetLayout":
            inv.return_value(build_layout())
        elif method == "GetGroupProperties":
            props = []
            for (i, p) in MENU_ITEMS:
                d = {}
                for k, v in p.items():
                    d[k] = GLib.Variant("s", v) if k != "enabled" else GLib.Variant("b", True)
                props.append((i, d))
            inv.return_value(GLib.Variant("(a(ia{sv}))", (props,)))
        elif method == "GetProperty":
            item_id, name = params.unpack()
            for (i, p) in MENU_ITEMS:
                if i == item_id:
                    if name == "enabled":
                        inv.return_value(GLib.Variant("(v)", (GLib.Variant("b", True),)))
                    else:
                        inv.return_value(GLib.Variant("(v)", (GLib.Variant("s", p.get(name, "")),)))
                    return
            inv.return_value(GLib.Variant("(v)", (GLib.Variant("s", ""),)))
        elif method == "Event":
            item_id, event_id, data, ts = params.unpack()
            if event_id == "clicked" and item_id in MENU_ACTIONS:
                action = MENU_ACTIONS[item_id]
                if action:
                    launch(action)
            inv.return_value(None)
        elif method == "EventGroup":
            events = params.unpack()[0]
            for (item_id, event_id, data, ts) in events:
                if event_id == "clicked" and item_id in MENU_ACTIONS:
                    action = MENU_ACTIONS[item_id]
                    if action:
                        launch(action)
            inv.return_value(GLib.Variant("(ai)", ([],)))
        elif method == "AboutToShow":
            inv.return_value(GLib.Variant("(b)", (False,)))
        elif method == "AboutToShowGroup":
            inv.return_value(GLib.Variant("(aiai)", ([], [])))
        else:
            inv.return_value(None)

    def on_menu_property(self, conn, sender, path, iface, prop, user_data=None):
        values = {
            "Version": GLib.Variant("u", 3),
            "TextDirection": variant("ltr"),
            "Status": variant("normal"),
            "IconThemePath": GLib.Variant("as", []),
        }
        return values.get(prop, GLib.Variant("u", 0))

    # ---- setup -----------------------------------------------------------
    def register_objects(self, conn):
        self.connection = conn
        conn.register_object(
            SNI_PATH,
            Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0],
            self.on_sni_method, self.on_sni_property, None,
        )
        conn.register_object(
            MENU_PATH,
            Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0],
            self.on_menu_method, self.on_menu_property, None,
        )

    def register_with_watcher(self):
        try:
            self.connection.call_sync(
                WATCHER_BUS, WATCHER_PATH, WATCHER_BUS,
                "RegisterStatusNotifierItem",
                GLib.Variant("(s)", (BUS_NAME,)),
                None, Gio.DBusCallFlags.NONE, 2000, None,
            )
            self.registered = True
            return False
        except GLib.Error as err:
            print("watcher not ready: %s" % err.message, flush=True)
            return True

    def refresh_tooltip(self):
        return False


def main():
    item = TrayItem()

    def on_watcher_appeared(conn, name, user_data=None):
        GLib.timeout_add(300, item.register_with_watcher)

    def on_watcher_vanished(conn, name, user_data=None):
        item.registered = False

    def on_bus_acquired(conn, name, user_data=None):
        item.register_objects(conn)
        Gio.bus_watch_name_on_connection(
            conn, WATCHER_BUS, Gio.BusNameWatcherFlags.NONE,
            on_watcher_appeared, on_watcher_vanished,
        )

    def on_name_acquired(conn, name, user_data=None):
        pass

    def on_name_lost(conn, name, user_data=None):
        pass

    Gio.bus_own_name(
        Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
        on_bus_acquired, on_name_acquired, on_name_lost,
    )

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
